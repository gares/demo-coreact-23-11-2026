% The Elpi program demo of demo.v: from the schema of a json file to the
% inductives objects and edges
accumulate "+elpi-json/utils". % json.lookup; it accumulates "+elpi-json" too

% [schema J Objects Morphisms] the names of the objects, and the morphisms
% as (triple Name Source Target), of the schema in J
func schema json -> list string, list (triple string string string).
schema J Objs Mors :-
  json.lookup J "schema" S,
  json.lookup S "objects" (json.assoc O), std.map O fst Objs,
  json.lookup S "morphisms" (json.assoc M), std.map M morphism Mors.

func morphism pair string json -> triple string string string.
morphism (pr Name (json.list [json.string Src, json.string Tgt])) (triple Name Src Tgt).

% [sanitize J J'] J' is J with names that are valid Rocq identifiers:
% json.copy, generated by ppx_elpi, copies J calling string.copy on each
% string (keys included), and the clauses given with => are tried before the
% one of string.copy (that copies the string as is)
func sanitize json -> json.
sanitize J J' :-
  [ (string.copy "=_E" "eq_E" :- !),
    (string.copy "s_{=_E}" "s_eq_E" :- !),
    (string.copy "t_{=_E}" "t_eq_E" :- !),
    (string.copy "c_0" "c₀" :- !),
    (string.copy "c_1" "c₁" :- !),
    (string.copy "c_2" "c₂" :- !) ] => json.copy J J'.

% Inductive objects : Set := V | E | ...
func objects-decl list string -> indt-decl.
objects-decl Objs (inductive "objects" tt (arity {{ Set }}) Ks) :-
  pi o\ std.map Objs (object-ctor o) (Ks o).

func object-ctor term, string -> indc-decl.
object-ctor O Name (constructor Name (arity O)).

% Inductive edges : objects -> objects -> Set := s_E : edges E V | ...
func edges-decl term, list (triple string string string) -> indt-decl.
edges-decl Obj Mors (inductive "edges" tt (arity {{ lp:Obj -> lp:Obj -> Set }}) Ks) :-
  pi e\ std.map Mors (edge-ctor e) (Ks e).

func edge-ctor term, triple string string string -> indc-decl.
edge-ctor E (triple Name Src Tgt) (constructor Name (arity (app [E, S, T]))) :-
  coq.locate Src SR, S = global SR,
  coq.locate Tgt TR, T = global TR.

func declare indt-decl -> inductive.
declare D I :-
  std.assert-ok! (coq.typecheck-indt-decl D) "illtyped inductive",
  coq.env.add-indt D I.

main [str Dep] :-
  std.assert! (coq.extra-dep Dep (some File)) "unknown Extra Dependency",
  std.assert-ok! (json.from_file File J) "cannot read the json file",
  sanitize J J1,
  schema J1 Objs Mors,
  declare {objects-decl Objs} ObjI,
  declare {edges-decl (global (indt ObjI)) Mors} _.
