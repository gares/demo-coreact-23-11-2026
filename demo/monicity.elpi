% Describing a schema and its axioms, as found in monicity-V1.json.
% Shared by demo.elpi (plain Elpi) and demo.v (Rocq-Elpi).
accumulate "+elpi-json/utils". % json.lookup; it accumulates "+elpi-json" too

namespace monicity {

% [monicity.describe J Lines] Lines describe the schema and the axioms of J
func describe json -> list string.
describe J Lines :-
  json.lookup J "schema" Schema,
  json.lookup Schema "objects" (json.assoc Objs),
  std.map Objs fst Names,
  std.string.concat ", " Names NamesS,
  json.lookup Schema "morphisms" (json.assoc Mors),
  std.map Mors morphism MorLines,
  json.lookup J "axioms" (json.assoc Axioms),
  std.map Axioms axiom AxLines,
  ObjLine is "objects: " ^ NamesS,
  std.flatten [[ObjLine, "morphisms:"], MorLines | AxLines] Lines.

% "s_E": ["E", "V"]  is  s_E : E -> V
func morphism pair string json -> string.
morphism (pr F (json.list [json.string A, json.string B])) S :-
  S is "  " ^ F ^ " : " ^ A ^ " -> " ^ B.

func axiom pair string json -> list string.
axiom (pr Name J) Lines :-
  json.lookup J "graphs" (json.assoc Gs),
  std.map Gs graph GLines,
  json.lookup J "graph_morphisms" (json.assoc Ms),
  std.map Ms graph-morphism MLines,
  Title is "axiom " ^ Name ^ ":",
  std.flatten [[Title], GLines, MLines] Lines.

% a graph: how many elements it has in each object of the schema
func graph pair string json -> string.
graph (pr Name G) S :-
  json.lookup G "o" (json.assoc Elems),
  std.map Elems size Sizes,
  std.string.concat " " Sizes SizesS,
  S is "  graph " ^ Name ^ "  " ^ SizesS.

func size pair string json -> string.
size (pr Obj (json.list L)) S :- std.length L N, S is Obj ^ "=" ^ {std.any->string N}.

% "q": ["R", "Q", {...}]  is  q : R -> Q
func graph-morphism pair string json -> string.
graph-morphism (pr Name (json.list [json.string Src, json.string Tgt, _])) S :-
  S is "  morphism " ^ Name ^ " : " ^ Src ^ " -> " ^ Tgt.

}
