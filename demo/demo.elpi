% Plain Elpi: the objects and the morphisms of the schema of monicity_data.json
%   elpi -exec main demo.elpi
accumulate "+elpi-json/utils". % json.lookup; it accumulates "+elpi-json" too

% [schema J Objects Morphisms] the names of the objects, and the morphisms
% as "Source --(Name)--> Target", of the schema in J
func schema json -> list string, list string.
schema J Objs Mors :-
  json.lookup J "schema" S,
  json.lookup S "objects" (json.assoc O), std.map O fst Objs,
  json.lookup S "morphisms" (json.assoc M), std.map M morphism Mors.

% "c_0": ["cmp", "E"]  is  cmp --(c_0)--> E
func morphism pair string json -> string.
morphism (pr Name (json.list [json.string Src, json.string Tgt])) S :-
  S is Src ^ " --(" ^ Name ^ ")--> " ^ Tgt.

% [pp-schema Objects Morphisms Doc] the layout of the schema
func pp-schema list string, list string -> std.fmt.
pp-schema Objs Mors
  (std.fmt.v 0 [
     std.fmt.hov 2 [std.fmt.txt "objects:", std.fmt.spc | ObjsDoc],
     std.fmt.cut,
     std.fmt.v 2 [std.fmt.txt "morphisms:", std.fmt.cut | MorsDoc]]) :-
  commas Objs ObjsDoc,
  std.map Mors txt MorsL,
  std.intersperse std.fmt.cut MorsL MorsDoc.

func txt string -> std.fmt.
txt S (std.fmt.txt S).

% a, b, c  with a break hint after each comma
func commas list string -> list std.fmt.
commas [] [].
commas [X] [std.fmt.txt X] :- !.
commas [X|XS] [std.fmt.txt X, std.fmt.txt ",", std.fmt.spc | R] :- commas XS R.

% [subscripts J J'] J' is J with c_0, c_1, c_2 written c₀, c₁, c₂
func subscripts json -> json.
subscripts J J' :-
  [ string.copy "c_0" "c₀",
    string.copy "c_1" "c₁",
    string.copy "c_2" "c₂" ] =!=> json.copy J J'.

func main list string.
main _ :-
  std.assert-ok! (json.from_file "monicity_data.json" J) "cannot read monicity_data.json",
  subscripts J J1,
  schema J1 Objs Mors,
  std.fmt->string _ {pp-schema Objs Mors} Text,
  print Text.
